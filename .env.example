# ==============================================================================
# Enterprise Agentic Compliance Pipeline - Environment Configuration
# ==============================================================================

# Application
APP_NAME="Enterprise Agentic Compliance Pipeline"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api"

# Groq LLM Configuration (Free Tier Models)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_PLANNER_MODEL="llama-3.3-70b-versatile"
GROQ_JUDGE_MODEL="deepseek-r1-distill-llama-70b"
GROQ_FAST_MODEL="llama-3.1-8b-instant"

# Dual PostgreSQL Configuration (Mapped to 5434 to avoid macOS host Postgres collision)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5434

# Database Names
GOVERNANCE_DB_NAME="governance_db"
STAGING_DB_NAME="staging_db"

# Database Connection URLs (Async asyncpg for SQLAlchemy)
GOVERNANCE_DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_password@localhost:5434/governance_db"
STAGING_DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_password@localhost:5434/staging_db"

# Sync DB URLs for LangGraph Checkpointer (psycopg3)
GOVERNANCE_SYNC_DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5434/governance_db"

# Redis Hot Tier (Session TTL, step counters, locks)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
REDIS_SESSION_TTL_SECONDS=86400

# MinIO S3 Cold Tier (Payload offload threshold > 5KB)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="agent-payloads"
MINIO_SECURE=False
PAYLOAD_OFFLOAD_THRESHOLD_BYTES=5120

# Cryptographic Human-In-The-Loop (HITL) Security
JWT_SECRET="enterprise_super_secret_signing_key_replace_in_prod_at_least_32_chars"
JWT_ALGORITHM="HS256"
APPROVAL_TOKEN_EXPIRE_MINUTES=1440

# FastMCP Sandbox Service
FASTMCP_SERVICE_URL="http://localhost:8001"

# LangSmith Observability & Distributed Tracing (https://smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGCHAIN_PROJECT="data-cleaner-ai-agent"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
