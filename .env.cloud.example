# ==============================================================================
# Cloud-Native Free Tier Production Environment Template
# (Render / Neon / Upstash / Cloudflare R2)
# ==============================================================================

# Application
APP_NAME="Enterprise Agentic Compliance Pipeline"
APP_ENV="production"
DEBUG=False
API_V1_PREFIX="/api"

# Groq LLM Key
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_PLANNER_MODEL="llama-3.3-70b-versatile"
GROQ_JUDGE_MODEL="deepseek-r1-distill-llama-70b"
GROQ_FAST_MODEL="llama-3.1-8b-instant"

# ------------------------------------------------------------------------------
# 1. Neon.tech PostgreSQL (Free Serverless Tier)
# Replace <user>, <password>, and <ep-xyz> with your Neon credentials.
# Note: Add `?ssl=require` for asyncpg and `?sslmode=require` for psycopg3
# ------------------------------------------------------------------------------
GOVERNANCE_DATABASE_URL="postgresql+asyncpg://<user>:<password>@<ep-xyz>.us-east-2.aws.neon.tech/governance_db?ssl=require"
STAGING_DATABASE_URL="postgresql+asyncpg://<user>:<password>@<ep-xyz>.us-east-2.aws.neon.tech/staging_db?ssl=require"
GOVERNANCE_SYNC_DATABASE_URL="postgresql://<user>:<password>@<ep-xyz>.us-east-2.aws.neon.tech/governance_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Free Serverless Redis with TLS)
# Obtain directly from Upstash console: "rediss://default:<password>@<endpoint>.upstash.io:<port>"
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:<password>@<endpoint>.upstash.io:6379"
REDIS_SESSION_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Object Storage (10 GB Free Forever, S3-Compatible)
# Replace <account-id>, <access-key-id>, and <secret-access-key>
# ------------------------------------------------------------------------------
MINIO_ENDPOINT="<account-id>.r2.cloudflarestorage.com"
MINIO_ACCESS_KEY="<r2-access-key-id>"
MINIO_SECRET_KEY="<r2-secret-access-key>"
MINIO_BUCKET_NAME="agent-payloads"
MINIO_SECURE=True
PAYLOAD_OFFLOAD_THRESHOLD_BYTES=5120

# ------------------------------------------------------------------------------
# 4. FastMCP Sandbox Service URL
# If deployed on Render: https://data-cleaner-fastmcp.onrender.com (or internal service host)
# ------------------------------------------------------------------------------
FASTMCP_SERVICE_URL="https://data-cleaner-fastmcp.onrender.com"

# ------------------------------------------------------------------------------
# 5. Security Credentials
# Generate a strong 32+ character random secret
# ------------------------------------------------------------------------------
JWT_SECRET="generate_a_random_32_character_string_for_production"
JWT_ALGORITHM="HS256"
APPROVAL_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace_with_secure_admin_password"

# ------------------------------------------------------------------------------
# 6. LangSmith Cloud Observability & Telemetry (https://smith.langchain.com)
# Set to "true" and insert your LangSmith API key to view live execution traces.
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGCHAIN_PROJECT="data-cleaner-ai-agent"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
