FROM python:3.12-slim

# Copy pre-compiled uv binary from official Astral image (blazing fast package installer)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

# Install FastMCP Python dependencies via uv (parallel, pre-compiled binary wheels)
COPY fastmcp_server/requirements.txt /app/fastmcp_requirements.txt
RUN uv pip install --system --no-cache -r /app/fastmcp_requirements.txt

# Copy application source code
COPY backend /app/backend
COPY fastmcp_server /app/fastmcp_server

EXPOSE 8001

CMD ["uvicorn", "fastmcp_server.server:app", "--host", "0.0.0.0", "--port", "8001"]
